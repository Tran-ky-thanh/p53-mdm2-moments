!data/cache_step4_zero_initial.npz
# Compact Step 5 summary plus clean snapshots for adding measures without
# rerunning the underlying Gillespie simulation.
!data/cache_step5.npz
# Compact moments and inferred networks for Figure 12's five-seed robustness analysis.
!data/cache_step8_robust.npz
